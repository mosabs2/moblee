{
  "_comment": "Starter permission rules for a Moblee vault. Merged (never replacing) into <vault>/.claude/settings.local.json by safety/install-safety.py. __VAULT__ is replaced with the vault's absolute path (which begins with /, so the rule form /__VAULT__ yields the //absolute/path form Claude Code expects). The allow list is broad only because the delete guard (bash-guard.py) inspects every shell command, and every script file a command runs, before it runs, whatever the allow list says.",
  "allow": [
    "Read(/__VAULT__/**)",
    "Edit(/__VAULT__/**)",
    "Write(/__VAULT__/**)",
    "Bash(git add:*)",
    "Bash(git commit:*)",
    "Bash(git log:*)",
    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git show:*)",
    "Bash(git rev-parse:*)",
    "Bash(git ls-files:*)",
    "Bash(git stash list:*)",
    "Bash(git config --get:*)",
    "Bash(git --version:*)",
    "Bash(grep:*)",
    "Bash(rg:*)",
    "Bash(ls:*)",
    "Bash(find:*)",
    "Bash(cat:*)",
    "Bash(head:*)",
    "Bash(tail:*)",
    "Bash(wc:*)",
    "Bash(sort:*)",
    "Bash(uniq:*)",
    "Bash(cut:*)",
    "Bash(tr:*)",
    "Bash(diff:*)",
    "Bash(date:*)",
    "Bash(pwd:*)",
    "Bash(echo:*)",
    "Bash(printf:*)",
    "Bash(mkdir:*)",
    "Bash(mv:*)",
    "Bash(cp:*)",
    "Bash(touch:*)",
    "Bash(stat:*)",
    "Bash(file:*)",
    "Bash(basename:*)",
    "Bash(dirname:*)",
    "Bash(which:*)",
    "Bash(sed -n:*)",
    "Bash(awk:*)",
    "Bash(open:*)",
    "Bash(sw_vers:*)",
    "Bash(uname:*)",
    "Bash(python3:*)",
    "Bash(bash:*)",
    "Bash(launchctl list:*)",
    "Bash(launchctl print:*)",
    "Bash(claude --version:*)"
  ],
  "deny": [
    "Bash(rm:*)",
    "Bash(rmdir:*)",
    "Bash(unlink:*)",
    "Bash(trash:*)",
    "Bash(truncate:*)",
    "Bash(git reset --hard:*)",
    "Bash(git clean:*)",
    "Bash(git push --force:*)",
    "Bash(git push -f:*)",
    "Bash(git push --force-with-lease:*)",
    "Bash(git rebase:*)",
    "Bash(git filter-branch:*)",
    "Bash(git restore:*)",
    "Bash(git stash drop:*)",
    "Bash(git stash clear:*)",
    "Bash(git branch -D:*)",
    "Bash(git branch -d:*)",
    "Bash(git reflog expire:*)",
    "Bash(git gc:*)",
    "Edit(/__VAULT__/.git/**)",
    "Write(/__VAULT__/.git/**)"
  ]
}
