# macOS
.DS_Store
.AppleDouble
.LSOverride

# Backups and discards
*.bak
*.bak2
*.tmp
.discarded/

# Editor swap files
*.swp
*~

# Python (for the render.py work)
__pycache__/
*.pyc

# Local state — let the user populate these
# (these are kept for structure via .gitkeep)
vault-template/raw/processed/*
!vault-template/raw/processed/.gitkeep
vault-template/Clippings/processed/*
!vault-template/Clippings/processed/.gitkeep
vault-template/outputs/*
!vault-template/outputs/.gitkeep

# Generated by user, not the starter pack
.installed

# Keys, certificates and signing profiles never belong in the repository: the
# notary credentials live in the keychain and the update key's private half never
# touches disk, so a file like these here is an export made by mistake
.env
*.p12
*.key
*.pem
*.cer
*.mobileprovision
*.provisionprofile

# Swift build output (committed by mistake in b78601a, removed from tracking 23 September 2026)
.build/

# A Claude Code session working in this repository keeps its own state here;
# it is never part of the pack (anchored to the top, so a wiki template is untouched)
/.claude/
