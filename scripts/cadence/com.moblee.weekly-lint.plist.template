<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Moblee weekly lint — launchd agent template.
  scripts/install-schedule.sh replaces every __HOME__ with the user's home
  folder and writes the result to ~/Library/LaunchAgents/com.moblee.weekly-lint.plist.
  Runs the structural lint every Saturday at 09:04 local time.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.moblee.weekly-lint</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.config/moblee/run-weekly-lint.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>4</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/.config/moblee/logs/launchd-weekly-lint.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.config/moblee/logs/launchd-weekly-lint.log</string>
</dict>
</plist>
