<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Moblee</string>
	<key>CFBundleExecutable</key>
	<string>Moblee</string>
	<key>CFBundleIconFile</key>
	<string>Moblee</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.mosabs2.moblee</string>
	<key>CFBundleName</key>
	<string>Moblee</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- (v0.9.5) Moblee will take files dropped on its icon in the Dock, so
	     that something an owner has saved can reach their wiki's inbox without
	     them finding the wiki folder in Finder. macOS will not let the Dock
	     icon accept a drop at all unless the app declares a type here, so this
	     is the smallest declaration that makes the drop possible:

	       LSItemContentTypes is public.item, which is anything at all. It has
	       to be, because the whole point is a scan, a PDF, a photo or a voice
	       memo, and naming a list would silently refuse whatever was left off it.

	       LSHandlerRank is None, which is what keeps that broad type harmless.
	       "None" says Moblee is not a handler for the type: it never becomes
	       the application a file opens in, it is never made the default for
	       anything, and it is not offered as an owner in Open With. It stays
	       eligible for a drop the owner aimed at it deliberately, and nothing
	       else. Owner or Alternate here would have put Moblee in front of an
	       owner double-clicking a PDF, which it cannot open and must never claim to.

	       CFBundleTypeRole is Viewer because the Dock will not highlight for an
	       app that says it does nothing with the type; nothing in Moblee views
	       a file, and nothing in it edits or saves one.

	     Nothing else in this file is changed by the drop feature. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Something for your wiki</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>0.15.0</string>
	<key>CFBundleVersion</key>
	<string>18</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- (v0.15.0) The updater (Sparkle; see Updater.swift for the whole account).
	     SUFeedURL: the signed list of releases, published beside each release's
	       zip; GitHub's "latest" address always points at the newest release's
	       copy, so withdrawing a release (marking it a pre-release) moves it back.
	     SUPublicEDKey: the public half of the maintainer's update key, written
	       by app/scripts/make-update-key.sh on 27 October 2026; the private half
	       never leaves his keychain, and release-app.sh refuses to build if the
	       two do not match.
	     SUVerifyUpdateBeforeExtraction and SURequireSignedFeed: the zip is
	       checked against that key before it is unpacked, and an unsigned or
	       altered list is refused, so the key is what lets an update in.
	     SUEnableAutomaticChecks and SUAllowsAutomaticUpdates off: Moblee never
	       looks or installs by itself; the owner presses Install. -->
	<key>SUFeedURL</key>
	<string>https://github.com/mosabs2/moblee/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>1qo+KA28GsZ9rFcLABVlSJsSaJIHLM9U+IsrmB/VWPg=</string>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
</dict>
</plist>
